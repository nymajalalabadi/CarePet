@{
    ViewData["Title"] = "About CarePet - Your Trusted Pet Care Partner";
    ViewData["Description"] = "Learn about CarePet's mission to connect loving families with their perfect pet companions. Our story, values, and commitment to animal welfare and responsible pet adoption.";
    ViewData["Keywords"] = "about carePet, animal welfare organization, pet adoption mission, animal shelter story, pet care values, rescue organization, animal rights";
    ViewData["OgImage"] = Context.Request.Scheme + "://" + Context.Request.Host + "/image/pets/pet1.png";
}

<!-- Hero Section -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">
                About <span class="gradient-text">CarePet</span>
            </h1>
            <p class="text-xl text-gray-300 max-w-3xl mx-auto">
                We're passionate about connecting loving families with their perfect pet companions and providing comprehensive care services to ensure every pet lives their happiest, healthiest life.
            </p>
        </div>

        <div class="glass-dark rounded-3xl p-8 md:p-12 mb-16">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="text-3xl md:text-4xl font-bold mb-6">
                        Our <span class="gradient-text">Mission</span>
                    </h2>
                    <p class="text-lg text-gray-300 mb-6">
                        At CarePet, we believe every pet deserves a loving home and the best possible care. Our mission is to create meaningful connections between pets and families while providing exceptional care services that enhance the quality of life for our furry friends.
                    </p>
                    <p class="text-lg text-gray-300">
                        Since our founding, we've successfully placed thousands of pets in loving homes and provided comprehensive care services that have made a real difference in the lives of pets and their families.
                    </p>
                </div>
                <div class="relative">
                    <img src="/image/pets/pet1.png" 
                         alt="Happy pets with their families" 
                         class="rounded-2xl w-full h-96 object-cover animate-float" />
                    <div class="absolute inset-0 bg-gradient-to-t from-dark-bg/20 to-transparent rounded-2xl"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values Section -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold mb-6">
                Our <span class="gradient-text">Core Values</span>
            </h2>
            <p class="text-xl text-gray-300 max-w-2xl mx-auto">
                These values guide everything we do and shape how we care for pets and serve families.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="glass-dark rounded-2xl p-8 text-center hover:scale-105 transition-all duration-300 sharp-shadow">
                <div class="w-16 h-16 bg-gradient-to-r from-primary-blue to-primary-purple rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-heart text-white text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-4">Compassion</h3>
                <p class="text-gray-300">Every pet receives loving care and attention, treating them as family members deserving of respect and kindness.</p>
            </div>

            <div class="glass-dark rounded-2xl p-8 text-center hover:scale-105 transition-all duration-300 sharp-shadow">
                <div class="w-16 h-16 bg-gradient-to-r from-primary-green to-primary-blue rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-award text-white text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-4">Excellence</h3>
                <p class="text-gray-300">We maintain the highest standards in pet care, continuously improving our services and expertise.</p>
            </div>

            <div class="glass-dark rounded-2xl p-8 text-center hover:scale-105 transition-all duration-300 sharp-shadow">
                <div class="w-16 h-16 bg-gradient-to-r from-primary-pink to-primary-orange rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-handshake text-white text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-4">Trust</h3>
                <p class="text-gray-300">Building lasting relationships through transparency, reliability, and honest communication with every family we serve.</p>
            </div>

            <div class="glass-dark rounded-2xl p-8 text-center hover:scale-105 transition-all duration-300 sharp-shadow">
                <div class="w-16 h-16 bg-gradient-to-r from-primary-yellow to-primary-green rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-seedling text-white text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-4">Growth</h3>
                <p class="text-gray-300">Supporting the healthy development and happiness of every pet while helping families create lasting bonds.</p>
            </div>
        </div>
    </div>
</section>

