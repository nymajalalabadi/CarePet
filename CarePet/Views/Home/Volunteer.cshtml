                    </li>
                    <li class="flex items-center">
                        <i class="fas fa-check text-primary-green mr-2"></i>
                        <span>Phone support</span>
                    </li>
                    <li class="flex items-center">
                        <i class="fas fa-check text-primary-green mr-2"></i>
                        <span>Adoption coordination</span>
                    </li>
                </ul>
                <div class="flex items-center justify-between">
                    <span class="glass px-3 py-1 rounded-full text-xs text-primary-green font-medium">
                        3-5 hours/week
                    </span>
                </div>
            </div>
            
            <!-- Event Support -->
            <div class="glass-dark rounded-3xl p-8 hover:scale-105 transition-all duration-300 sharp-shadow">
                <div class="w-16 h-16 bg-gradient-to-r from-primary-pink to-primary-orange rounded-2xl flex items-center justify-center mb-6">
                    <i class="fas fa-calendar-alt text-white text-2xl"></i>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">Event Support</h3>
