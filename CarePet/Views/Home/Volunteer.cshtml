@model CarePet.Models.VolunteerApplication
@{
    ViewData["Title"] = "Volunteer Opportunities";
}

<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">
                Volunteer <span class="gradient-text">Opportunities</span>
            </h1>
            <p class="text-xl text-gray-300 max-w-3xl mx-auto">
                Join our passionate team of volunteers and make a real difference in the lives of animals. Whether you have an hour a week or several days a month, there's a perfect opportunity waiting for you.
            </p>
        </div>

        <div class="glass-dark rounded-3xl p-8 md:p-12 mb-16">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="text-3xl md:text-4xl font-bold mb-6">
                        Make a <span class="gradient-text">Difference</span>
                    </h2>
                    <p class="text-lg text-gray-300 mb-6">
                        Volunteering with CarePet is more than just giving your time - it's about creating meaningful connections and transforming lives. Every hour you contribute helps save and improve the lives of animals in need.
                    </p>
                    <p class="text-lg text-gray-300">
                        From hands-on pet care to administrative support, find the perfect volunteer role that matches your skills, interests, and schedule. Join our amazing community of animal lovers today.
                    </p>
                    
                    <!-- Impact Statistics -->
                    <div class="grid grid-cols-2 gap-4 mt-8">
                        <div class="text-center">
                            <div class="w-12 h-12 bg-gradient-to-r from-primary-blue to-primary-purple rounded-full flex items-center justify-center mx-auto mb-2">
                                <i class="fas fa-users text-white text-lg"></i>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-1">200+</h3>
                            <p class="text-gray-400 text-sm">Active Volunteers</p>
                        </div>
                        
                        <div class="text-center">
                            <div class="w-12 h-12 bg-gradient-to-r from-primary-green to-primary-blue rounded-full flex items-center justify-center mx-auto mb-2">
                                <i class="fas fa-clock text-white text-lg"></i>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-1">10K+</h3>
                            <p class="text-gray-400 text-sm">Hours This Year</p>
                        </div>
                        
                        <div class="text-center">
                            <div class="w-12 h-12 bg-gradient-to-r from-primary-pink to-primary-orange rounded-full flex items-center justify-center mx-auto mb-2">
                                <i class="fas fa-paw text-white text-lg"></i>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-1">500+</h3>
                            <p class="text-gray-400 text-sm">Pets Helped</p>
                        </div>
                        
                        <div class="text-center">
                            <div class="w-12 h-12 bg-gradient-to-r from-primary-yellow to-primary-green rounded-full flex items-center justify-center mx-auto mb-2">
                                <i class="fas fa-heart text-white text-lg"></i>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-1">300+</h3>
                            <p class="text-gray-400 text-sm">Successful Adoptions</p>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <img src="/image/pets/DogFunny.png" 
                         alt="Volunteers caring for animals" 
                         class="rounded-2xl w-full h-96 object-cover animate-float" />
                    <div class="absolute inset-0 bg-gradient-to-t from-dark-bg/20 to-transparent rounded-2xl"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Volunteer Opportunities -->
<section class="pb-20 px-4 sm:px-6 lg:px-8">
