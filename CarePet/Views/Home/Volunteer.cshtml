                    </li>
                    <li class="flex items-center">
                        <i class="fas fa-check text-primary-green mr-2"></i>
                        <span>Fundraising activities</span>
                    </li>
                    <li class="flex items-center">
                        <i class="fas fa-check text-primary-green mr-2"></i>
                        <span>Community outreach</span>
                    </li>
                </ul>
                <div class="flex items-center justify-between">
                    <span class="glass px-3 py-1 rounded-full text-xs text-primary-pink font-medium">
                        Weekend events
                    </span>
                </div>
            </div>
            
            <!-- Transportation -->
