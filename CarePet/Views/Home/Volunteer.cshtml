<!-- Volunteer Application Form -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
            <h2 class="text-4xl md:text-5xl font-bold mb-6">
                Join Our <span class="gradient-text">Team</span>
            </h2>
            <p class="text-xl text-gray-300 max-w-2xl mx-auto">
                Ready to make a difference? Fill out our volunteer application and we'll get back to you within 48 hours.
            </p>
        </div>
        
        <div class="glass-dark rounded-3xl p-8 md:p-12">
            <form asp-controller="Home" asp-action="Volunteer" method="post" class="space-y-6">
                <!-- Personal Information -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="FirstName" class="block text-white font-medium mb-2">First Name *</label>
                        <input asp-for="FirstName" type="text" required class="w-full glass px-4 py-3 rounded-lg bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0">
                        <span asp-validation-for="FirstName" class="text-red-400 text-sm"></span>
                    </div>
                    
                    <div>
                        <label for="LastName" class="block text-white font-medium mb-2">Last Name *</label>
                        <input asp-for="LastName" type="text" required class="w-full glass px-4 py-3 rounded-lg bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0">
                        <span asp-validation-for="LastName" class="text-red-400 text-sm"></span>
                    </div>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="Email" class="block text-white font-medium mb-2">Email Address *</label>
                        <input asp-for="Email" type="email" required class="w-full glass px-4 py-3 rounded-lg bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0">
                        <span asp-validation-for="Email" class="text-red-400 text-sm"></span>
                    </div>
                    
                    <div>
                        <label for="Phone" class="block text-white font-medium mb-2">Phone Number *</label>
                        <input asp-for="Phone" type="tel" required class="w-full glass px-4 py-3 rounded-lg bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0">
                        <span asp-validation-for="Phone" class="text-red-400 text-sm"></span>
                    </div>
                </div>
                
                <div>
                    <label for="Address" class="block text-white font-medium mb-2">Address</label>
                    <input asp-for="Address" type="text" class="w-full glass px-4 py-3 rounded-lg bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0">
                </div>
                
                <div>
                    <label for="DateOfBirth" class="block text-white font-medium mb-2">Date of Birth</label>
                    <input asp-for="DateOfBirth" type="date" class="w-full glass px-4 py-3 rounded-lg bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0">
                </div>
                
                <!-- Availability -->
                <div>
                    <label for="Availability" class="block text-white font-medium mb-2">When are you available? *</label>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <label class="glass px-4 py-3 rounded-lg cursor-pointer hover:bg-white/10 transition-all duration-200">
                            <input type="checkbox" name="Availability" value="Monday" class="mr-2">
                            <span class="text-white">Monday</span>
                        </label>
                        <label class="glass px-4 py-3 rounded-lg cursor-pointer hover:bg-white/10 transition-all duration-200">
                            <input type="checkbox" name="Availability" value="Tuesday" class="mr-2">
                            <span class="text-white">Tuesday</span>
                        </label>
                        <label class="glass px-4 py-3 rounded-lg cursor-pointer hover:bg-white/10 transition-all duration-200">
                            <input type="checkbox" name="Availability" value="Wednesday" class="mr-2">
                            <span class="text-white">Wednesday</span>
                        </label>
                        <label class="glass px-4 py-3 rounded-lg cursor-pointer hover:bg-white/10 transition-all duration-200">
                            <input type="checkbox" name="Availability" value="Thursday" class="mr-2">
                            <span class="text-white">Thursday</span>
                        </label>
                        <label class="glass px-4 py-3 rounded-lg cursor-pointer hover:bg-white/10 transition-all duration-200">
                            <input type="checkbox" name="Availability" value="Friday" class="mr-2">
                            <span class="text-white">Friday</span>
                        </label>
                        <label class="glass px-4 py-3 rounded-lg cursor-pointer hover:bg-white/10 transition-all duration-200">
                            <input type="checkbox" name="Availability" value="Saturday" class="mr-2">
                            <span class="text-white">Saturday</span>
                        </label>
                        <label class="glass px-4 py-3 rounded-lg cursor-pointer hover:bg-white/10 transition-all duration-200">
                            <input type="checkbox" name="Availability" value="Sunday" class="mr-2">
                            <span class="text-white">Sunday</span>
                        </label>
                        <label class="glass px-4 py-3 rounded-lg cursor-pointer hover:bg-white/10 transition-all duration-200">
                            <input type="checkbox" name="Availability" value="Weekends" class="mr-2">
                            <span class="text-white">Weekends Only</span>
                        </label>
                    </div>
                </div>
                
                <!-- Experience -->
                <div>
                    <label for="Experience" class="block text-white font-medium mb-2">Pet Experience</label>
                    <textarea asp-for="Experience" rows="4" placeholder="Tell us about your experience with pets..." class="w-full glass px-4 py-3 rounded-lg bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0 resize-none"></textarea>
                </div>
                
                <div>
                    <label for="WhyVolunteer" class="block text-white font-medium mb-2">Why do you want to volunteer with us? *</label>
                    <textarea asp-for="WhyVolunteer" rows="4" required placeholder="Share your motivation..." class="w-full glass px-4 py-3 rounded-lg bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0 resize-none"></textarea>
                    <span asp-validation-for="WhyVolunteer" class="text-red-400 text-sm"></span>
                </div>
                
                <div>
                    <label for="Skills" class="block text-white font-medium mb-2">Special Skills or Talents</label>
                    <textarea asp-for="Skills" rows="3" placeholder="Any special skills that might help us?" class="w-full glass px-4 py-3 rounded-lg bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0 resize-none"></textarea>
                </div>
                
                <!-- Emergency Contact -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="EmergencyContactName" class="block text-white font-medium mb-2">Emergency Contact Name</label>
                        <input asp-for="EmergencyContactName" type="text" class="w-full glass px-4 py-3 rounded-lg bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0">
                    </div>
                    
                    <div>
                        <label for="EmergencyContactPhone" class="block text-white font-medium mb-2">Emergency Contact Phone</label>
                        <input asp-for="EmergencyContactPhone" type="tel" class="w-full glass px-4 py-3 rounded-lg bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0">
                    </div>
                </div>
                
                <!-- Terms Agreement -->
                <div class="flex items-start">
                    <input asp-for="AcceptTerms" type="checkbox" required class="mt-1 mr-3 rounded border-gray-300 text-primary-blue focus:ring-primary-blue">
                    <label for="AcceptTerms" class="text-gray-300">
                        I agree to the <a asp-controller="Home" asp-action="Terms" class="text-primary-blue hover:text-primary-green transition-colors">Terms and Conditions</a> and understand the responsibilities of volunteering with CarePet. *
                    </label>
                </div>
                <span asp-validation-for="AcceptTerms" class="text-red-400 text-sm block"></span>
                
                <button type="submit" class="w-full bg-gradient-to-r from-primary-blue to-primary-purple px-8 py-4 rounded-full text-white font-semibold hover:from-primary-purple hover:to-primary-blue transition-all duration-300">
                    Submit Volunteer Application
                </button>
            </form>
        </div>
    </div>
</section>

<!-- Volunteer Benefits -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold mb-6">
                Volunteer <span class="gradient-text">Benefits</span>
            </h2>
            <p class="text-xl text-gray-300 max-w-2xl mx-auto">
                Volunteering isn't just about giving back - you'll gain valuable experiences and benefits too!
