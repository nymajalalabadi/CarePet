@model List<CarePet.Models.CareService>
@{
    ViewData["Title"] = "Pet Care Services - Professional Care for Your Beloved Pets";
}

<!-- Header Section -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">
                Premium <span class="gradient-text">Pet Care Services</span>
            </h1>
            <p class="text-xl text-gray-300 max-w-3xl mx-auto">
                Comprehensive care services designed to keep your beloved pets healthy, happy, and well-groomed. Our experienced professionals provide top-quality care with love and attention.
            </p>
        </div>

        <!-- Categories Filter -->
        <div class="glass-dark rounded-2xl p-6 mb-12">
            <div class="flex flex-wrap gap-4 justify-center">
                <button class="category-btn active px-6 py-3 rounded-full font-medium transition-all duration-300" data-category="all">
                    All Services
                </button>
                <button class="category-btn px-6 py-3 rounded-full font-medium transition-all duration-300" data-category="Grooming">
                    <i class="fas fa-cut mr-2"></i>
                    Grooming
                </button>
                <button class="category-btn px-6 py-3 rounded-full font-medium transition-all duration-300" data-category="Medical">
                    <i class="fas fa-stethoscope mr-2"></i>
                    Medical
                </button>
                <button class="category-btn px-6 py-3 rounded-full font-medium transition-all duration-300" data-category="Training">
                    <i class="fas fa-graduation-cap mr-2"></i>
                    Training
                </button>
                <button class="category-btn px-6 py-3 rounded-full font-medium transition-all duration-300" data-category="Care">
                    <i class="fas fa-home mr-2"></i>
                    Care
                </button>
                <button class="category-btn px-6 py-3 rounded-full font-medium transition-all duration-300" data-category="Exercise">
                    <i class="fas fa-running mr-2"></i>
                    Exercise
                </button>
                <button class="category-btn px-6 py-3 rounded-full font-medium transition-all duration-300" data-category="Boarding">
                    <i class="fas fa-bed mr-2"></i>
                    Boarding
                </button>
            </div>
        </div>

        <!-- Services Grid -->
        <div id="servicesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var service in Model)
            {
                <div class="service-card glass-dark rounded-2xl overflow-hidden hover:scale-105 transition-all duration-300 sharp-shadow group" 
                     data-category="@service.Category">
                    <div class="p-8">
                        <!-- Service Icon & Popular Badge -->
                        <div class="flex items-start justify-between mb-6">
                            <div class="w-16 h-16 bg-gradient-to-r from-primary-blue to-primary-purple rounded-2xl flex items-center justify-center">
                                <i class="fas fa-@service.IconName text-white text-2xl"></i>
                            </div>
                            @if (service.IsPopular)
                            {
                                <span class="glass px-3 py-1 rounded-full text-sm text-primary-yellow font-medium">
                                    <i class="fas fa-star mr-1"></i>
                                    Popular
                                </span>
                            }
                        </div>

                        <!-- Service Info -->
                        <h3 class="text-2xl font-bold text-white mb-4">@service.Title</h3>
                        <p class="text-gray-300 mb-6 line-clamp-3">@service.Description</p>

                        <!-- Service Details -->
                        <div class="space-y-3 mb-6">
                            <div class="flex items-center justify-between">
                                <span class="text-gray-400 flex items-center">
                                    <i class="fas fa-dollar-sign text-primary-green mr-2"></i>
                                    Price
                                </span>
                                <span class="text-primary-yellow font-bold text-xl">$@service.Price.ToString("F0")</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-400 flex items-center">
                                    <i class="fas fa-clock text-primary-blue mr-2"></i>
                                    Duration
                                </span>
                                <span class="text-white font-medium">@service.Duration</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-400 flex items-center">
                                    <i class="fas fa-tag text-primary-pink mr-2"></i>
                                    Category
                                </span>
                                <span class="text-white font-medium">@service.Category</span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex gap-3">
                            <button class="flex-1 glass px-4 py-3 rounded-lg text-primary-blue font-medium hover:bg-primary-blue hover:text-white transition-all duration-300">
                                <i class="fas fa-calendar mr-2"></i>
                                Book Now
                            </button>
                            <button class="glass p-3 rounded-lg text-primary-pink hover:bg-primary-pink hover:text-white transition-all duration-300">
                                <i class="fas fa-info-circle"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- No Results Message -->
        <div id="noResults" class="hidden text-center py-20">
            <div class="glass-dark rounded-2xl p-12 max-w-md mx-auto">
                <i class="fas fa-search text-6xl text-gray-400 mb-6"></i>
                <h3 class="text-2xl font-bold text-white mb-4">No Services Found</h3>
                <p class="text-gray-300 mb-6">We couldn't find any services in this category.</p>
                <button id="showAllServices" class="glass px-6 py-3 rounded-lg text-primary-blue font-medium hover:bg-primary-blue hover:text-white transition-all duration-300">
                    Show All Services
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
