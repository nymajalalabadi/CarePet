@model CarePet.Models.Contact
@{
    ViewData["Title"] = "Contact CarePet - Get in Touch Today";
}

<!-- Header Section -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">
                Get in <span class="gradient-text">Touch</span>
            </h1>
            <p class="text-xl text-gray-300 max-w-3xl mx-auto">
                Have questions about our pets or services? We'd love to hear from you! Our team is here to help you find the perfect companion or answer any questions about pet care.
            </p>
        </div>

        <!-- Success Message -->
        @if (TempData["Success"] != null)
        {
            <div class="glass-dark border border-primary-green rounded-2xl p-6 mb-8 max-w-2xl mx-auto">
                <div class="flex items-center">
                    <i class="fas fa-check-circle text-primary-green text-2xl mr-4"></i>
                    <div>
                        <h3 class="text-lg font-semibold text-white mb-1">Message Sent Successfully!</h3>
                        <p class="text-gray-300">@TempData["Success"]</p>
                    </div>
                </div>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <!-- Contact Form -->
            <div class="glass-dark rounded-3xl p-8 md:p-12">
                <h2 class="text-3xl font-bold text-white mb-8">Send us a Message</h2>
                
                <form asp-action="Contact" method="post" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label asp-for="Name" class="block text-sm font-medium text-gray-300 mb-2">Full Name *</label>
                            <input asp-for="Name" 
                                   class="w-full glass rounded-lg px-4 py-3 text-white bg-transparent border border-white/20 focus:border-primary-blue focus:outline-none focus:ring-2 focus:ring-primary-blue/50 transition-all duration-300"
                                   placeholder="Enter your full name" />
                            <span asp-validation-for="Name" class="text-red-400 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="Email" class="block text-sm font-medium text-gray-300 mb-2">Email Address *</label>
                            <input asp-for="Email" type="email"
                                   class="w-full glass rounded-lg px-4 py-3 text-white bg-transparent border border-white/20 focus:border-primary-blue focus:outline-none focus:ring-2 focus:ring-primary-blue/50 transition-all duration-300"
                                   placeholder="Enter your email address" />
                            <span asp-validation-for="Email" class="text-red-400 text-sm"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label asp-for="Phone" class="block text-sm font-medium text-gray-300 mb-2">Phone Number *</label>
                            <input asp-for="Phone" type="tel"
                                   class="w-full glass rounded-lg px-4 py-3 text-white bg-transparent border border-white/20 focus:border-primary-blue focus:outline-none focus:ring-2 focus:ring-primary-blue/50 transition-all duration-300"
                                   placeholder="Enter your phone number" />
                            <span asp-validation-for="Phone" class="text-red-400 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="Subject" class="block text-sm font-medium text-gray-300 mb-2">Subject</label>
                            <select asp-for="Subject" 
                                    class="w-full glass rounded-lg px-4 py-3 text-white bg-transparent border border-white/20 focus:border-primary-blue focus:outline-none focus:ring-2 focus:ring-primary-blue/50 transition-all duration-300">
                                <option value="">Select a subject</option>
                                <option value="Pet Adoption">Pet Adoption</option>
                                <option value="Pet Care Services">Pet Care Services</option>
                                <option value="General Inquiry">General Inquiry</option>
                                <option value="Emergency">Emergency</option>
                                <option value="Complaint">Complaint</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Message" class="block text-sm font-medium text-gray-300 mb-2">Message *</label>
                        <textarea asp-for="Message" rows="6"
                                  class="w-full glass rounded-lg px-4 py-3 text-white bg-transparent border border-white/20 focus:border-primary-blue focus:outline-none focus:ring-2 focus:ring-primary-blue/50 transition-all duration-300 resize-none"
                                  placeholder="Tell us how we can help you..."></textarea>
                        <span asp-validation-for="Message" class="text-red-400 text-sm"></span>
                    </div>

                    <!-- Terms and Privacy Checkbox -->
                    <div class="flex items-start space-x-3">
                        <div class="flex-shrink-0 mt-1">
                            <input asp-for="AcceptTerms" type="checkbox" id="AcceptTerms"
                                   class="w-5 h-5 rounded border-2 border-white/20 bg-transparent checked:bg-primary-blue checked:border-primary-blue focus:ring-2 focus:ring-primary-blue/50 transition-all duration-300" />
                        </div>
                        <div class="flex-grow">
                            <label for="AcceptTerms" class="text-sm text-gray-300 cursor-pointer">
                                I agree to the 
                                <a asp-controller="Home" asp-action="Terms" class="text-primary-blue hover:text-primary-purple underline transition-colors duration-300" target="_blank">Terms of Service</a> 
                                and 
                                <a asp-controller="Home" asp-action="Privacy" class="text-primary-blue hover:text-primary-purple underline transition-colors duration-300" target="_blank">Privacy Policy</a> *
                            </label>
                            <span asp-validation-for="AcceptTerms" class="block text-red-400 text-sm mt-1"></span>
                        </div>
                    </div>

                    <button type="submit" 
                            class="w-full bg-gradient-to-r from-primary-blue to-primary-purple hover:from-primary-purple hover:to-primary-blue px-8 py-4 rounded-lg text-white font-semibold transition-all duration-300 sharp-shadow transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none">
                        <i class="fas fa-paper-plane mr-2"></i>
                        Send Message
                    </button>
                </form>
            </div>

            <!-- Contact Information -->
            <div class="space-y-8">
                <!-- Contact Cards -->
                <div class="glass-dark rounded-2xl p-8">
                    <h3 class="text-2xl font-bold text-white mb-6">Contact Information</h3>
                    <div class="space-y-6">
                        <div class="flex items-center">
                            <div class="w-12 h-12 bg-gradient-to-r from-primary-blue to-primary-purple rounded-lg flex items-center justify-center mr-4">
                                <i class="fas fa-phone text-white text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-white font-semibold">Phone</h4>
                                <p class="text-gray-300">+1 (555) 123-4567</p>
                            </div>
                        </div>

                        <div class="flex items-center">
                            <div class="w-12 h-12 bg-gradient-to-r from-primary-green to-primary-blue rounded-lg flex items-center justify-center mr-4">
                                <i class="fas fa-envelope text-white text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-white font-semibold">Email</h4>
                                <p class="text-gray-300">info@carepet.com</p>
                            </div>
                        </div>

                        <div class="flex items-center">
                            <div class="w-12 h-12 bg-gradient-to-r from-primary-pink to-primary-orange rounded-lg flex items-center justify-center mr-4">
                                <i class="fas fa-map-marker-alt text-white text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-white font-semibold">Address</h4>
                                <p class="text-gray-300">123 Pet Care Street<br>Animal City, AC 12345</p>
                            </div>
                        </div>

                        <div class="flex items-center">
                            <div class="w-12 h-12 bg-gradient-to-r from-primary-yellow to-primary-green rounded-lg flex items-center justify-center mr-4">
                                <i class="fas fa-clock text-white text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-white font-semibold">Business Hours</h4>
                                <p class="text-gray-300">Mon-Fri: 8:00 AM - 8:00 PM<br>Sat-Sun: 9:00 AM - 6:00 PM</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Emergency Contact -->
                <div class="glass-dark rounded-2xl p-8 border-2 border-red-500/30">
                    <h3 class="text-2xl font-bold text-red-400 mb-4">
                        <i class="fas fa-exclamation-triangle mr-2"></i>
                        Emergency Contact
                    </h3>
                    <p class="text-gray-300 mb-4">For urgent pet emergencies outside business hours:</p>
                    <div class="flex items-center mb-4">
                        <i class="fas fa-phone text-red-400 mr-3"></i>
                        <span class="text-white font-semibold text-lg">+1 (555) 911-PETS</span>
                    </div>
                    <p class="text-sm text-gray-400">Available 24/7 for emergency situations</p>
                </div>

                <!-- Social Media -->
                <div class="glass-dark rounded-2xl p-8">
                    <h3 class="text-2xl font-bold text-white mb-6">Follow Us</h3>
                    <div class="flex space-x-4">
                        <a href="#" class="w-12 h-12 bg-gradient-to-r from-primary-blue to-primary-purple rounded-lg flex items-center justify-center hover:scale-110 transition-transform duration-300">
                            <i class="fab fa-facebook-f text-white text-lg"></i>
                        </a>
                        <a href="#" class="w-12 h-12 bg-gradient-to-r from-primary-pink to-primary-orange rounded-lg flex items-center justify-center hover:scale-110 transition-transform duration-300">
                            <i class="fab fa-instagram text-white text-lg"></i>
                        </a>
                        <a href="#" class="w-12 h-12 bg-gradient-to-r from-primary-blue to-primary-green rounded-lg flex items-center justify-center hover:scale-110 transition-transform duration-300">
                            <i class="fab fa-twitter text-white text-lg"></i>
                        </a>
                        <a href="#" class="w-12 h-12 bg-gradient-to-r from-primary-purple to-primary-pink rounded-lg flex items-center justify-center hover:scale-110 transition-transform duration-300">
                            <i class="fab fa-youtube text-white text-lg"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Map Section -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
            <h2 class="text-4xl md:text-5xl font-bold mb-6">
                Visit Our <span class="gradient-text">Location</span>
            </h2>
            <p class="text-xl text-gray-300 max-w-2xl mx-auto">
                Come visit us in person! We'd love to show you around our facility and introduce you to our wonderful pets.
            </p>
        </div>

        <div class="glass-dark rounded-3xl p-8 overflow-hidden">
            <div class="bg-gray-800 rounded-2xl h-96 flex items-center justify-center">
                <div class="text-center">
                    <i class="fas fa-map-marked-alt text-6xl text-primary-blue mb-4"></i>
                    <h3 class="text-2xl font-bold text-white mb-2">Interactive Map</h3>
                    <p class="text-gray-300 mb-4">123 Pet Care Street, Animal City, AC 12345</p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="https://maps.google.com/?q=123+Pet+Care+Street+Animal+City" 
                           target="_blank"
                           class="glass px-6 py-3 rounded-lg text-primary-blue font-medium hover:bg-primary-blue hover:text-white transition-all duration-300">
                            <i class="fas fa-directions mr-2"></i>
                            Get Directions
                        </a>
                        <a href="tel:+1-555-123-4567" 
                           class="glass px-6 py-3 rounded-lg text-primary-green font-medium hover:bg-primary-green hover:text-white transition-all duration-300">
                            <i class="fas fa-phone mr-2"></i>
                            Call Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold mb-6">
                Frequently Asked <span class="gradient-text">Questions</span>
            </h2>
            <p class="text-xl text-gray-300">
                Quick answers to common questions about our services and adoption process.
            </p>
        </div>

        <div class="space-y-6">
            <div class="glass-dark rounded-2xl overflow-hidden">
                <button class="w-full p-6 text-left flex items-center justify-between faq-toggle" data-target="faq1">
                    <h3 class="text-lg font-semibold text-white">What is the adoption process like?</h3>
                    <i class="fas fa-chevron-down text-primary-blue transition-transform duration-300"></i>
                </button>
                <div id="faq1" class="hidden px-6 pb-6">
                    <p class="text-gray-300">Our adoption process includes an application, meet-and-greet session, home visit (if required), and finalization. We want to ensure the perfect match between pets and families for a lifetime of happiness.</p>
                </div>
            </div>

            <div class="glass-dark rounded-2xl overflow-hidden">
                <button class="w-full p-6 text-left flex items-center justify-between faq-toggle" data-target="faq2">
                    <h3 class="text-lg font-semibold text-white">What services do you offer for existing pets?</h3>
                    <i class="fas fa-chevron-down text-primary-blue transition-transform duration-300"></i>
                </button>
                <div id="faq2" class="hidden px-6 pb-6">
                    <p class="text-gray-300">We offer comprehensive pet care services including grooming, veterinary care, training, pet sitting, boarding, and emergency services. Our goal is to support your pet's health and happiness throughout their life.</p>
                </div>
            </div>

            <div class="glass-dark rounded-2xl overflow-hidden">
                <button class="w-full p-6 text-left flex items-center justify-between faq-toggle" data-target="faq3">
                    <h3 class="text-lg font-semibold text-white">Do you offer emergency services?</h3>
                    <i class="fas fa-chevron-down text-primary-blue transition-transform duration-300"></i>
                </button>
                <div id="faq3" class="hidden px-6 pb-6">
                    <p class="text-gray-300">Yes! We provide 24/7 emergency services for urgent pet health situations. Call our emergency line at +1 (555) 911-PETS for immediate assistance outside regular business hours.</p>
                </div>
            </div>

            <div class="glass-dark rounded-2xl overflow-hidden">
                <button class="w-full p-6 text-left flex items-center justify-between faq-toggle" data-target="faq4">
                    <h3 class="text-lg font-semibold text-white">What are your fees and payment options?</h3>
                    <i class="fas fa-chevron-down text-primary-blue transition-transform duration-300"></i>
                </button>
                <div id="faq4" class="hidden px-6 pb-6">
                    <p class="text-gray-300">Adoption fees vary by pet and include vaccinations, spaying/neutering, and microchipping. Service fees are competitive and we accept cash, credit cards, and offer payment plans for larger services.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // FAQ Toggle functionality
            const faqToggles = document.querySelectorAll('.faq-toggle');
            
            faqToggles.forEach(toggle => {
                toggle.addEventListener('click', function() {
                    const targetId = this.getAttribute('data-target');
                    const target = document.getElementById(targetId);
                    const icon = this.querySelector('i');
                    
                    // Close all other FAQs
                    faqToggles.forEach(otherToggle => {
                        if (otherToggle !== this) {
                            const otherTargetId = otherToggle.getAttribute('data-target');
                            const otherTarget = document.getElementById(otherTargetId);
                            const otherIcon = otherToggle.querySelector('i');
                            
                            otherTarget.classList.add('hidden');
                            otherIcon.style.transform = 'rotate(0deg)';
                        }
                    });
                    
                    // Toggle current FAQ
                    if (target.classList.contains('hidden')) {
                        target.classList.remove('hidden');
                        icon.style.transform = 'rotate(180deg)';
                    } else {
                        target.classList.add('hidden');
                        icon.style.transform = 'rotate(0deg)';
                    }
                });
            });

            // Form validation enhancement
            const form = document.querySelector('form');
            const inputs = form.querySelectorAll('input, textarea, select');
            
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.classList.add('ring-2', 'ring-primary-blue/50');
                });
                
                input.addEventListener('blur', function() {
                    this.classList.remove('ring-2', 'ring-primary-blue/50');
                });
            });
        });
    </script>
}

<style>
    select option {
        background-color: #0A0A0A;
        color: white;
    }
    
    .faq-toggle:hover {
        background-color: rgba(255, 255, 255, 0.05);
    }
</style> 