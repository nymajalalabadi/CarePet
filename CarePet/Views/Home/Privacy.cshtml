@{
    ViewData["Title"] = "Privacy Policy";
}

<!-- Page Header -->
<section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">
            Privacy <span class="gradient-text">Policy</span>
        </h1>
        <p class="text-xl text-gray-300 mb-8">
            Your privacy matters to us. Learn how we collect, use, and protect your personal information.
        </p>
        <div class="glass px-6 py-3 rounded-full inline-block">
            <span class="text-primary-blue font-medium">Last Updated: December 2024</span>
        </div>
    </div>
</section>

<!-- Privacy Content -->
<section class="pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <div class="glass-dark rounded-3xl p-8 md:p-12">
            
            <!-- Introduction -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">1. Information We Collect</h2>
                <p class="text-gray-300 text-lg leading-relaxed mb-6">
                    We collect information to provide better services to our users and help connect pets with loving families.
                </p>
                
                <h3 class="text-xl font-semibold text-white mb-4">Personal Information</h3>
                <ul class="text-gray-300 text-lg space-y-2 ml-6 mb-6">
                    <li class="flex items-start">
                        <i class="fas fa-user text-primary-blue mr-3 mt-1"></i>
                        Name, email address, phone number
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-home text-primary-blue mr-3 mt-1"></i>
                        Address and housing information
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-id-card text-primary-blue mr-3 mt-1"></i>
                        Government-issued ID for verification
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-users text-primary-blue mr-3 mt-1"></i>
                        Family and household information
                    </li>
                </ul>

                <h3 class="text-xl font-semibold text-white mb-4">Usage Information</h3>
                <ul class="text-gray-300 text-lg space-y-2 ml-6">
                    <li class="flex items-start">
                        <i class="fas fa-chart-line text-primary-green mr-3 mt-1"></i>
                        Website usage patterns and preferences
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-mobile-alt text-primary-green mr-3 mt-1"></i>
                        Device information and IP address
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-cookie-bite text-primary-green mr-3 mt-1"></i>
                        Cookies and similar tracking technologies
                    </li>
                </ul>
            </div>

            <!-- How We Use Information -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">2. How We Use Your Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="glass rounded-2xl p-6">
                        <div class="flex items-center mb-4">
                            <i class="fas fa-heart text-primary-pink text-2xl mr-3"></i>
                            <h3 class="text-xl font-semibold text-white">Pet Matching</h3>
                        </div>
                        <p class="text-gray-300">
                            To match you with suitable pets based on your lifestyle, preferences, and living situation.
                        </p>
                    </div>
                    
                    <div class="glass rounded-2xl p-6">
                        <div class="flex items-center mb-4">
                            <i class="fas fa-envelope text-primary-blue text-2xl mr-3"></i>
                            <h3 class="text-xl font-semibold text-white">Communication</h3>
                        </div>
                        <p class="text-gray-300">
                            To send appointment confirmations, updates about your adopted pets, and important service announcements.
                        </p>
                    </div>
                    
                    <div class="glass rounded-2xl p-6">
                        <div class="flex items-center mb-4">
                            <i class="fas fa-shield-alt text-primary-yellow text-2xl mr-3"></i>
                            <h3 class="text-xl font-semibold text-white">Safety & Security</h3>
                        </div>
                        <p class="text-gray-300">
                            To verify your identity and ensure the safety of our pets through background checks when necessary.
                        </p>
                    </div>
                    
                    <div class="glass rounded-2xl p-6">
                        <div class="flex items-center mb-4">
                            <i class="fas fa-chart-bar text-primary-green text-2xl mr-3"></i>
                            <h3 class="text-xl font-semibold text-white">Service Improvement</h3>
                        </div>
                        <p class="text-gray-300">
                            To analyze usage patterns and improve our website functionality and services.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Information Sharing -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">3. Information Sharing</h2>
                <div class="glass rounded-2xl p-6 border border-red-500/30 bg-red-500/10 mb-6">
                    <div class="flex items-start">
                        <i class="fas fa-lock text-red-400 mr-3 mt-1 text-xl"></i>
                        <div>
                            <h3 class="text-red-400 font-semibold text-lg mb-2">We Never Sell Your Data</h3>
                            <p class="text-gray-300">
                                CarePet does not sell, rent, or trade your personal information to third parties for marketing purposes.
                            </p>
                        </div>
                    </div>
                </div>
                
                <p class="text-gray-300 text-lg leading-relaxed mb-4">
                    We may share your information only in these limited circumstances:
                </p>
                <ul class="text-gray-300 text-lg space-y-2 ml-6">
                    <li class="flex items-start">
                        <i class="fas fa-user-md text-primary-blue mr-3 mt-1"></i>
                        With veterinarians for your pet's medical care
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-gavel text-primary-blue mr-3 mt-1"></i>
                        When required by law or legal process
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-hands-helping text-primary-blue mr-3 mt-1"></i>
                        With trusted service providers who assist our operations
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-exclamation-triangle text-primary-blue mr-3 mt-1"></i>
                        In emergency situations to protect pet or human safety
                    </li>
                </ul>
            </div>

            <!-- Data Security -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">4. Data Security</h2>
                <p class="text-gray-300 text-lg leading-relaxed mb-6">
                    We implement multiple layers of security to protect your personal information:
                </p>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="glass rounded-xl p-4 text-center">
                        <i class="fas fa-lock text-primary-green text-3xl mb-3"></i>
                        <h4 class="text-white font-semibold mb-2">Encryption</h4>
                        <p class="text-gray-300 text-sm">SSL/TLS encryption for data transmission</p>
                    </div>
                    <div class="glass rounded-xl p-4 text-center">
                        <i class="fas fa-server text-primary-blue text-3xl mb-3"></i>
                        <h4 class="text-white font-semibold mb-2">Secure Storage</h4>
                        <p class="text-gray-300 text-sm">Protected servers with access controls</p>
                    </div>
                    <div class="glass rounded-xl p-4 text-center">
                        <i class="fas fa-eye text-primary-purple text-3xl mb-3"></i>
                        <h4 class="text-white font-semibold mb-2">Access Monitoring</h4>
                        <p class="text-gray-300 text-sm">Regular security audits and monitoring</p>
                    </div>
                </div>
            </div>

            <!-- Your Rights -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">5. Your Rights</h2>
                <p class="text-gray-300 text-lg leading-relaxed mb-6">
                    You have the following rights regarding your personal information:
                </p>
                <div class="space-y-4">
                    <div class="flex items-start">
                        <i class="fas fa-eye text-primary-blue mr-4 mt-1 text-xl"></i>
                        <div>
                            <h4 class="text-white font-semibold text-lg">Access</h4>
                            <p class="text-gray-300">Request a copy of the personal information we hold about you.</p>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-edit text-primary-green mr-4 mt-1 text-xl"></i>
                        <div>
                            <h4 class="text-white font-semibold text-lg">Correction</h4>
                            <p class="text-gray-300">Request correction of inaccurate or incomplete information.</p>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-trash text-primary-red mr-4 mt-1 text-xl"></i>
                        <div>
                            <h4 class="text-white font-semibold text-lg">Deletion</h4>
                            <p class="text-gray-300">Request deletion of your personal information (subject to legal requirements).</p>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-ban text-primary-yellow mr-4 mt-1 text-xl"></i>
                        <div>
                            <h4 class="text-white font-semibold text-lg">Opt-out</h4>
                            <p class="text-gray-300">Unsubscribe from marketing communications at any time.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cookies -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">6. Cookies and Tracking</h2>
                <p class="text-gray-300 text-lg leading-relaxed mb-4">
                    We use cookies and similar technologies to enhance your browsing experience:
                </p>
                <ul class="text-gray-300 text-lg space-y-2 ml-6">
                    <li class="flex items-start">
                        <i class="fas fa-cog text-primary-blue mr-3 mt-1"></i>
                        Essential cookies for website functionality
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-chart-line text-primary-green mr-3 mt-1"></i>
                        Analytics cookies to understand usage patterns
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-user text-primary-purple mr-3 mt-1"></i>
                        Preference cookies to remember your settings
                    </li>
                </ul>
                <p class="text-gray-300 text-lg leading-relaxed mt-4">
                    You can control cookies through your browser settings, though some features may not work properly if cookies are disabled.
                </p>
            </div>

            <!-- Contact -->
            <div class="border-t border-white/10 pt-8">
                <h2 class="text-3xl font-bold text-white mb-6">7. Contact Us About Privacy</h2>
                <p class="text-gray-300 text-lg leading-relaxed mb-6">
                    If you have questions about this Privacy Policy or want to exercise your rights, contact us:
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex items-center">
                        <i class="fas fa-envelope text-primary-blue mr-3"></i>
                        <span class="text-white">privacy@carepet.com</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-phone text-primary-green mr-3"></i>
                        <span class="text-white">(555) 123-4567</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Back to Contact -->
<section class="pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
        <a asp-controller="Home" asp-action="Contact" 
           class="inline-flex items-center glass px-8 py-4 rounded-full text-primary-blue font-semibold hover:bg-primary-blue hover:text-white transition-all duration-300 transform hover:scale-105">
            <i class="fas fa-arrow-left mr-2"></i>
            Back to Contact
        </a>
    </div>
</section>
