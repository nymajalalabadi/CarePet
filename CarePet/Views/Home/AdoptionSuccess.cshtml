@model CarePet.Models.Pet
@{
    ViewData["Title"] = $"Application Submitted - {Model.Name}";
}

<!-- Success Section -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
        <!-- Success Animation -->
        <div class="mb-12">
            <div class="w-32 h-32 bg-gradient-to-r from-primary-green to-primary-blue rounded-full flex items-center justify-center mx-auto mb-8 animate-pulse">
                <i class="fas fa-check text-white text-6xl"></i>
            </div>
            <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
                Application <span class="gradient-text">Submitted!</span>
            </h1>
            <p class="text-xl md:text-2xl text-gray-300 max-w-2xl mx-auto">
                Thank you for your interest in adopting <span class="text-primary-blue font-semibold">@Model.Name</span>!
                We've received your application and will review it carefully.
            </p>
        </div>

        <!-- Pet Info Card -->
        <div class="glass-dark rounded-3xl p-8 mb-12">
            <div class="flex flex-col md:flex-row items-center gap-8">
                <div class="w-48 h-48 rounded-full overflow-hidden sharp-shadow">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-full object-cover" />
                </div>
                <div class="text-center md:text-left">
                    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">@Model.Name</h2>
                    <p class="text-xl text-gray-300 mb-6">
                        @Model.Breed • @Model.Age year@(Model.Age != 1 ? "s" : "") old • @Model.Gender
                    </p>
                    <p class="text-lg text-gray-400">
                        We're excited that you want to give @Model.Name a loving forever home!
                    </p>
                </div>
            </div>
        </div>

        <!-- Next Steps -->
        <div class="glass-dark rounded-3xl p-8 md:p-12 mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-8">
                What <span class="gradient-text">Happens Next?</span>
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="glass rounded-2xl p-8">
                    <div class="w-16 h-16 bg-gradient-to-r from-primary-blue to-primary-purple rounded-full flex items-center justify-center mx-auto mb-6">
                        <span class="text-white font-bold text-2xl">1</span>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-4">Application Review</h3>
                    <p class="text-gray-300">
                        Our adoption team will carefully review your application within 2-3 business days.
                    </p>
                </div>

                <div class="glass rounded-2xl p-8">
                    <div class="w-16 h-16 bg-gradient-to-r from-primary-green to-primary-blue rounded-full flex items-center justify-center mx-auto mb-6">
                        <span class="text-white font-bold text-2xl">2</span>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-4">Contact & Interview</h3>
                    <p class="text-gray-300">
                        If approved, we'll contact you to schedule a phone interview and potential meet-and-greet.
                    </p>
                </div>

                <div class="glass rounded-2xl p-8">
                    <div class="w-16 h-16 bg-gradient-to-r from-primary-pink to-primary-orange rounded-full flex items-center justify-center mx-auto mb-6">
                        <span class="text-white font-bold text-2xl">3</span>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-4">Home Visit</h3>
                    <p class="text-gray-300">
                        A home visit will be scheduled to ensure @Model.Name's safety and comfort.
                    </p>
                </div>
            </div>
        </div>

        <!-- Important Information -->
        <div class="glass rounded-3xl p-8 md:p-12 mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-8">
                Important <span class="gradient-text">Information</span>
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left">
                <div class="space-y-6">
                    <div class="flex items-start">
                        <div class="w-8 h-8 bg-gradient-to-r from-primary-blue to-primary-purple rounded-full flex items-center justify-center mr-4 mt-1">
                            <i class="fas fa-clock text-white text-sm"></i>
                        </div>
                        <div>
                            <h3 class="text-white font-bold mb-2">Response Time</h3>
                            <p class="text-gray-300">We'll contact you within 2-3 business days via email or phone.</p>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-8 h-8 bg-gradient-to-r from-primary-green to-primary-blue rounded-full flex items-center justify-center mr-4 mt-1">
                            <i class="fas fa-dollar-sign text-white text-sm"></i>
                        </div>
                        <div>
                            <h3 class="text-white font-bold mb-2">Adoption Fee</h3>
                            <p class="text-gray-300">Our adoption fee is $150-$300 and includes spaying/neutering, vaccinations, and microchipping.</p>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-8 h-8 bg-gradient-to-r from-primary-pink to-primary-orange rounded-full flex items-center justify-center mr-4 mt-1">
                            <i class="fas fa-home text-white text-sm"></i>
                        </div>
                        <div>
                            <h3 class="text-white font-bold mb-2">Preparation</h3>
                            <p class="text-gray-300">Start preparing your home with pet supplies: food, bed, toys, and safety measures.</p>
                        </div>
                    </div>
                </div>

                <div class="space-y-6">
                    <div class="flex items-start">
                        <div class="w-8 h-8 bg-gradient-to-r from-primary-yellow to-primary-green rounded-full flex items-center justify-center mr-4 mt-1">
                            <i class="fas fa-phone text-white text-sm"></i>
                        </div>
                        <div>
                            <h3 class="text-white font-bold mb-2">Stay in Touch</h3>
                            <p class="text-gray-300">Feel free to call us at (555) 123-4567 if you have any questions.</p>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-8 h-8 bg-gradient-to-r from-primary-purple to-primary-pink rounded-full flex items-center justify-center mr-4 mt-1">
                            <i class="fas fa-stethoscope text-white text-sm"></i>
                        </div>
                        <div>
                            <h3 class="text-white font-bold mb-2">Health Records</h3>
                            <p class="text-gray-300">@Model.Name's complete health records and vaccination history will be provided.</p>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-8 h-8 bg-gradient-to-r from-primary-orange to-primary-yellow rounded-full flex items-center justify-center mr-4 mt-1">
                            <i class="fas fa-heart text-white text-sm"></i>
                        </div>
                        <div>
                            <h3 class="text-white font-bold mb-2">Support</h3>
                            <p class="text-gray-300">We provide ongoing support and advice for @Model.Name's transition to their new home.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Success Message -->
        @if (TempData["Success"] != null)
        {
            <div class="glass-success rounded-2xl p-6 mb-8">
                <div class="flex items-center justify-center">
                    <i class="fas fa-check-circle text-primary-green text-2xl mr-3"></i>
                    <p class="text-lg text-white font-semibold">@TempData["Success"]</p>
                </div>
            </div>
        }

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a asp-controller="Home" asp-action="Pets" class="glass px-8 py-4 rounded-full text-primary-blue font-semibold hover:bg-primary-blue hover:text-white transition-all duration-300 sharp-shadow">
                <i class="fas fa-paw mr-2"></i>
                Browse Other Pets
            </a>
            <a asp-controller="Home" asp-action="Contact" class="glass-dark px-8 py-4 rounded-full text-white font-semibold hover:bg-primary-purple hover:text-white transition-all duration-300 sharp-shadow-pink">
                <i class="fas fa-envelope mr-2"></i>
                Contact Us
            </a>
            <a asp-controller="Home" asp-action="Index" class="bg-gradient-to-r from-primary-blue to-primary-purple hover:from-primary-purple hover:to-primary-blue px-8 py-4 rounded-full text-white font-semibold transition-all duration-300 sharp-shadow transform hover:scale-105">
                <i class="fas fa-home mr-2"></i>
                Back to Home
            </a>
        </div>

        <!-- Thank You Message -->
        <div class="mt-16 text-center">
            <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">
                Thank You for Choosing <span class="gradient-text">CarePet</span>
            </h3>
            <p class="text-lg text-gray-300 max-w-2xl mx-auto">
                Your decision to adopt saves a life and makes room for us to help another pet in need. 
                @Model.Name is lucky to have someone who cares enough to consider adoption!
            </p>
        </div>
    </div>
</section> 