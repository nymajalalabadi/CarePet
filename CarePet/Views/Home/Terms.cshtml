@{
    ViewData["Title"] = "Terms of Service";
}

<!-- Page Header -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">
                Terms of <span class="gradient-text">Service</span>
            </h1>
            <p class="text-xl text-gray-300 max-w-3xl mx-auto">
                Please read these terms carefully before using our services. By using CarePet, you agree to these terms and our commitment to responsible pet care and adoption.
            </p>
        </div>

        <div class="glass-dark rounded-3xl p-8 md:p-12 mb-16">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="text-3xl md:text-4xl font-bold mb-6">
                        Our <span class="gradient-text">Legal Framework</span>
                    </h2>
                    <p class="text-lg text-gray-300 mb-6">
                        These terms outline the legal relationship between CarePet and our valued customers. We've created a comprehensive framework that protects both pets and adopters while ensuring the highest standards of care.
                    </p>
                    <p class="text-lg text-gray-300 mb-6">
                        Our terms cover adoption processes, service agreements, responsibilities, and policies designed to create successful, lasting relationships between pets and their new families.
                    </p>
                    
                    <div class="glass px-6 py-3 rounded-full inline-block">
                        <span class="text-primary-blue font-medium">Last Updated: December 2024</span>
                    </div>
                </div>
                <div class="relative">
                    <img src="https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=600&h=400&fit=crop" 
                         alt="Legal documents and pet care policies" 
                         class="rounded-2xl w-full h-96 object-cover animate-float" />
                    <div class="absolute inset-0 bg-gradient-to-t from-dark-bg/20 to-transparent rounded-2xl"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Terms Content -->
<section class="pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <div class="glass-dark rounded-3xl p-8 md:p-12">
            
            <!-- Introduction -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">1. Introduction</h2>
                <p class="text-gray-300 text-lg leading-relaxed mb-6">
                    Welcome to CarePet! These Terms of Service ("Terms") govern your use of our website, services, and adoption programs. CarePet is committed to connecting loving pets with caring families while providing exceptional pet care services.
                </p>
                <div class="glass rounded-2xl p-6 border border-primary-blue/30">
                    <div class="flex items-start">
                        <i class="fas fa-info-circle text-primary-blue mr-3 mt-1 text-xl"></i>
                        <div>
                            <h3 class="text-primary-blue font-semibold text-lg mb-2">Important Notice</h3>
                            <p class="text-gray-300">
                                By accessing or using CarePet services, you acknowledge that you have read, understood, and agree to be bound by these Terms.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Our Services -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">2. Our Services</h2>
                <p class="text-gray-300 text-lg leading-relaxed mb-6">
                    CarePet provides the following services:
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="glass rounded-2xl p-6">
                        <div class="flex items-center mb-4">
                            <i class="fas fa-heart text-primary-pink text-2xl mr-3"></i>
                            <h3 class="text-xl font-semibold text-white">Pet Adoption</h3>
                        </div>
                        <p class="text-gray-300">
                            Facilitating the adoption of pets from shelters and rescue organizations to loving homes.
                        </p>
                    </div>
                    
                    <div class="glass rounded-2xl p-6">
                        <div class="flex items-center mb-4">
                            <i class="fas fa-spa text-primary-blue text-2xl mr-3"></i>
                            <h3 class="text-xl font-semibold text-white">Pet Care Services</h3>
                        </div>
                        <p class="text-gray-300">
                            Professional grooming, veterinary care, training, boarding, and sitting services.
                        </p>
                    </div>
                    
                    <div class="glass rounded-2xl p-6">
                        <div class="flex items-center mb-4">
                            <i class="fas fa-graduation-cap text-primary-green text-2xl mr-3"></i>
                            <h3 class="text-xl font-semibold text-white">Training Programs</h3>
                        </div>
                        <p class="text-gray-300">
                            Behavioral training and obedience classes for pets of all ages and sizes.
                        </p>
                    </div>
                    
                    <div class="glass rounded-2xl p-6">
                        <div class="flex items-center mb-4">
                            <i class="fas fa-stethoscope text-primary-yellow text-2xl mr-3"></i>
                            <h3 class="text-xl font-semibold text-white">Veterinary Care</h3>
                        </div>
                        <p class="text-gray-300">
                            Health checkups, vaccinations, emergency care, and medical treatments.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Adoption Process & Responsibilities -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">3. Adoption Process & Responsibilities</h2>
                
                <h3 class="text-xl font-semibold text-white mb-4">Adoption Requirements</h3>
                <ul class="text-gray-300 text-lg space-y-2 ml-6 mb-6">
                    <li class="flex items-start">
                        <i class="fas fa-check text-primary-green mr-3 mt-1"></i>
                        Must be 18 years or older to adopt
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-check text-primary-green mr-3 mt-1"></i>
                        Provide valid identification and proof of residence
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-check text-primary-green mr-3 mt-1"></i>
                        Complete adoption application and interview process
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-check text-primary-green mr-3 mt-1"></i>
                        Agree to home visit if required
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-check text-primary-green mr-3 mt-1"></i>
                        Pay applicable adoption fees and costs
                    </li>
                </ul>

                <h3 class="text-xl font-semibold text-white mb-4">Adopter Responsibilities</h3>
                <div class="glass rounded-2xl p-6 bg-gradient-to-r from-primary-blue/10 to-primary-green/10">
                    <ul class="text-gray-300 text-lg space-y-3">
                        <li class="flex items-start">
                            <i class="fas fa-home text-primary-blue mr-3 mt-1"></i>
                            Provide a safe, loving, and permanent home for the pet
                        </li>
                        <li class="flex items-start">
                            <i class="fas fa-medical-kit text-primary-green mr-3 mt-1"></i>
                            Ensure proper veterinary care, including regular checkups and vaccinations
                        </li>
                        <li class="flex items-start">
                            <i class="fas fa-utensils text-primary-yellow mr-3 mt-1"></i>
                            Provide adequate food, water, shelter, and exercise
                        </li>
                        <li class="flex items-start">
                            <i class="fas fa-phone text-primary-pink mr-3 mt-1"></i>
                            Contact CarePet if unable to continue caring for the pet
                        </li>
                    </ul>
                </div>
            </div>

            <!-- User Responsibilities -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">4. User Responsibilities</h2>
                <p class="text-gray-300 text-lg leading-relaxed mb-4">
                    When using CarePet services, you agree to:
                </p>
                <ul class="text-gray-300 text-lg space-y-2 ml-6 mb-6">
                    <li class="flex items-start">
                        <i class="fas fa-truth text-primary-blue mr-3 mt-1"></i>
                        Provide accurate and truthful information
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-shield-alt text-primary-blue mr-3 mt-1"></i>
                        Respect the welfare and safety of all animals
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-users text-primary-blue mr-3 mt-1"></i>
                        Treat staff, volunteers, and other customers with respect
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-clock text-primary-blue mr-3 mt-1"></i>
                        Arrive on time for scheduled appointments
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-dollar-sign text-primary-blue mr-3 mt-1"></i>
                        Pay all fees and charges promptly
                    </li>
                </ul>
            </div>

            <!-- Prohibited Activities -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">5. Prohibited Activities</h2>
                <div class="glass rounded-2xl p-6 border border-red-500/30 bg-red-500/10 mb-6">
                    <div class="flex items-start">
                        <i class="fas fa-ban text-red-400 mr-3 mt-1 text-xl"></i>
                        <div>
                            <h3 class="text-red-400 font-semibold text-lg mb-2">Strictly Prohibited</h3>
                            <p class="text-gray-300 mb-4">
                                The following activities are strictly prohibited and may result in immediate termination of services:
                            </p>
                            <ul class="text-gray-300 space-y-2">
                                <li>• Animal abuse, neglect, or cruelty of any kind</li>
                                <li>• Providing false information during adoption process</li>
                                <li>• Using our services for commercial breeding or resale</li>
                                <li>• Harassment of staff, volunteers, or other customers</li>
                                <li>• Bringing weapons or illegal substances to our facilities</li>
                                <li>• Damaging property or equipment</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Legal Matters -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">6. Legal Matters</h2>
                
                <h3 class="text-xl font-semibold text-white mb-4">Liability</h3>
                <p class="text-gray-300 text-lg leading-relaxed mb-6">
                    CarePet provides services with reasonable care and skill. However, we cannot guarantee outcomes and are not liable for indirect damages or losses. Pet owners are responsible for their pets' behavior and any damages caused.
                </p>

                <h3 class="text-xl font-semibold text-white mb-4">Intellectual Property</h3>
                <p class="text-gray-300 text-lg leading-relaxed mb-6">
                    All content on our website, including text, images, logos, and designs, are protected by copyright and trademark laws. You may not use our content without written permission.
                </p>

                <h3 class="text-xl font-semibold text-white mb-4">Governing Law</h3>
                <p class="text-gray-300 text-lg leading-relaxed">
                    These Terms are governed by local and state laws. Any disputes will be resolved through binding arbitration or in local courts.
                </p>
            </div>

            <!-- Modifications -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">7. Modifications to Terms</h2>
                <p class="text-gray-300 text-lg leading-relaxed mb-4">
                    CarePet reserves the right to modify these Terms at any time. We will notify users of significant changes through:
                </p>
                <ul class="text-gray-300 text-lg space-y-2 ml-6">
                    <li class="flex items-start">
                        <i class="fas fa-envelope text-primary-blue mr-3 mt-1"></i>
                        Email notifications to registered users
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-bell text-primary-blue mr-3 mt-1"></i>
                        Website announcements and notifications
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-calendar text-primary-blue mr-3 mt-1"></i>
                        30-day notice period for major changes
                    </li>
                </ul>
            </div>

            <!-- Contact Information -->
            <div class="glass rounded-2xl p-6 bg-gradient-to-r from-primary-purple/10 to-primary-blue/10">
                <h2 class="text-2xl font-bold text-white mb-4">Questions About These Terms?</h2>
                <p class="text-gray-300 mb-6">
                    If you have any questions about these Terms of Service, please contact us:
                </p>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="flex items-center">
                        <i class="fas fa-envelope text-primary-blue mr-3"></i>
                        <span class="text-white">legal@carepet.com</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-phone text-primary-green mr-3"></i>
                        <span class="text-white">+1 (555) 123-4567</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-map-marker-alt text-primary-pink mr-3"></i>
                        <span class="text-white">123 Pet Care St, City</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-20 md:py-24 lg:py-28 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto text-center">
        <div class="glass-dark rounded-3xl p-8 md:p-12 lg:p-16">
            <div class="w-16 h-16 md:w-20 md:h-20 bg-gradient-to-r from-primary-blue to-primary-purple rounded-2xl flex items-center justify-center mx-auto mb-6 md:mb-8 shadow-xl">
                <i class="fas fa-shield-alt text-white text-2xl md:text-3xl"></i>
            </div>
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-4 md:mb-6">
                Questions About <span class="gradient-text">Terms</span>?
            </h2>
            <p class="text-lg md:text-xl text-gray-300 mb-8 md:mb-10 lg:mb-12 max-w-2xl mx-auto">
                If you have any questions about this Terms of Service or how we handle your personal information, we're here to help.
            </p>
            <a asp-controller="Home" asp-action="Contact" 
               class="inline-flex items-center glass px-10 md:px-12 lg:px-16 py-4 md:py-5 lg:py-6 rounded-full text-primary-blue font-semibold hover:bg-primary-blue hover:text-white transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-2xl text-base md:text-lg lg:text-xl">
                <i class="fas fa-arrow-left mr-3 md:mr-4"></i>
                Back to Contact
            </a>
        </div>
    </div>
</section>


<style>
    .glass {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .glass-dark {
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .gradient-text {
        background: linear-gradient(135deg, #2979FF, #00E676, #FF80AB);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradient 3s ease infinite;
    }
</style> 