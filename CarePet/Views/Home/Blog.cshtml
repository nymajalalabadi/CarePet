@model List<CarePet.Models.BlogPost>
@{
    ViewData["Title"] = "Pet Care Blog";
}

<!-- Page Header -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">
                Pet Care <span class="gradient-text">Blog</span>
            </h1>
            <p class="text-xl text-gray-300 max-w-3xl mx-auto">
                Expert advice, heartwarming stories, and essential tips to help you give your pets the best care possible. Discover the latest insights from veterinarians and pet care professionals.
            </p>
        </div>

        <div class="glass-dark rounded-3xl p-8 md:p-12 mb-16">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="text-3xl md:text-4xl font-bold mb-6">
                        Your Pet Care <span class="gradient-text">Resource Hub</span>
                    </h2>
                    <p class="text-lg text-gray-300 mb-6">
                        Stay informed with the latest pet care advice, training tips, and heartwarming adoption stories. Our expert team shares knowledge to help you provide the best possible care for your furry family members.
                    </p>
                    <p class="text-lg text-gray-300">
                        From nutrition guides to behavioral insights, find everything you need to ensure your pet's health, happiness, and well-being in our comprehensive blog library.
                    </p>
                    
                    <!-- Category Filters -->
                    <div class="flex flex-wrap gap-3 mt-8">
                        <button class="glass px-4 py-2 rounded-full text-primary-blue font-medium hover:bg-primary-blue hover:text-white transition-all duration-300 category-filter active" data-category="all">
                            All Posts
                        </button>
                        <button class="glass px-4 py-2 rounded-full text-gray-300 font-medium hover:bg-primary-green hover:text-white transition-all duration-300 category-filter" data-category="Pet Care">
                            Pet Care
                        </button>
                        <button class="glass px-4 py-2 rounded-full text-gray-300 font-medium hover:bg-primary-pink hover:text-white transition-all duration-300 category-filter" data-category="Training">
                            Training
                        </button>
                        <button class="glass px-4 py-2 rounded-full text-gray-300 font-medium hover:bg-primary-yellow hover:text-white transition-all duration-300 category-filter" data-category="Adoption">
                            Adoption
                        </button>
                        <button class="glass px-4 py-2 rounded-full text-gray-300 font-medium hover:bg-primary-purple hover:text-white transition-all duration-300 category-filter" data-category="Behavior">
                            Behavior
                        </button>
                    </div>
                </div>
                <div class="relative">
                    <img src="/image/pets/pet1.png" 
                         alt="Pet care and training resources" 
                         class="rounded-2xl w-full h-96 object-cover animate-float" />
                    <div class="absolute inset-0 bg-gradient-to-t from-dark-bg/20 to-transparent rounded-2xl"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Post -->
@if (Model.Any())
{
    var featuredPost = Model.First();
    <section class="pb-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <div class="glass-dark rounded-3xl overflow-hidden mb-20">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <div class="aspect-[4/3] overflow-hidden">
                        <img src="@featuredPost.ImageUrl" alt="@featuredPost.Title" class="w-full h-full object-cover hover:scale-110 transition-transform duration-500" />
                    </div>
                    <div class="p-8 lg:p-12 flex flex-col justify-center">
                        <div class="flex items-center mb-4">
                            <span class="glass px-4 py-2 rounded-full text-primary-blue font-medium text-sm">
                                <i class="fas fa-star mr-2"></i>Featured
                            </span>
                            <span class="ml-4 text-gray-400">@featuredPost.Date.ToString("MMM dd, yyyy")</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">@featuredPost.Title</h2>
                        <p class="text-gray-300 text-lg mb-6 leading-relaxed">@featuredPost.Excerpt</p>
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex items-center">
                                <i class="fas fa-user mr-2"></i>
                                <div>
                                    <p class="text-white font-medium">@featuredPost.Author</p>
                                    <p class="text-gray-400 text-sm">@featuredPost.Category</p>
                                </div>
                            </div>
                            <div class="flex items-center text-gray-400">
                                <i class="fas fa-eye mr-2"></i>
                                <span>@featuredPost.Views views</span>
                            </div>
                        </div>
                        <a asp-controller="Home" asp-action="BlogPost" asp-route-id="@featuredPost.Id" class="glass px-6 py-3 rounded-full text-primary-blue font-semibold hover:bg-primary-blue hover:text-white transition-all duration-300 inline-flex items-center">
                            Read Full Article
                            <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<!-- Blog Posts Grid -->
<section class="pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-white">
                Latest <span class="gradient-text">Articles</span>
            </h2>
            <div class="hidden md:flex items-center space-x-4">
                <input type="text" id="search-input" placeholder="Search articles..." class="glass px-4 py-2 rounded-full bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0">
                <button id="search-btn" class="glass px-4 py-2 rounded-full text-primary-blue hover:bg-primary-blue hover:text-white transition-all duration-300">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="blog-grid">
            @foreach (var post in Model.Skip(1))
            {
                <article class="glass-dark rounded-2xl overflow-hidden hover:scale-105 transition-all duration-300 sharp-shadow blog-post" data-category="@post.Category">
                    <div class="aspect-[4/3] overflow-hidden">
                        <img src="@post.ImageUrl" alt="@post.Title" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                    </div>
                    <div class="p-6">
                        <div class="flex items-center justify-between mb-3">
                            <span class="glass px-3 py-1 rounded-full text-sm text-primary-green font-medium">
                                @post.Category
                            </span>
                            <span class="text-gray-400 text-sm">@post.Date.ToString("MMM dd")</span>
                        </div>
                        
                        <h3 class="text-xl font-bold text-white mb-3 line-clamp-2">@post.Title</h3>
                        
                        <p class="text-gray-400 mb-4 line-clamp-3">@post.Excerpt</p>
                        
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center">
                                <i class="fas fa-user mr-1"></i>
                                <span class="text-gray-300 text-sm">@post.Author</span>
                            </div>
                            <div class="flex items-center text-gray-400 text-sm">
                                <i class="fas fa-eye mr-1"></i>
                                <span>@post.Views</span>
                            </div>
                        </div>
                        
                        <a asp-controller="Home" asp-action="BlogPost" asp-route-id="@post.Id" class="glass px-4 py-2 rounded-lg text-primary-blue font-medium hover:bg-primary-blue hover:text-white transition-all duration-300 inline-flex items-center w-full justify-center">
                            Read More
                            <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                    </div>
                </article>
            }
        </div>

    </div>
</section>

<!-- Newsletter Subscription -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <div class="glass-dark rounded-3xl p-8 md:p-12 text-center">
            <div class="w-16 h-16 bg-gradient-to-r from-primary-blue to-primary-purple rounded-2xl flex items-center justify-center mx-auto mb-6">
                <i class="fas fa-newspaper text-white text-2xl"></i>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold mb-6">
                Stay Updated with <span class="gradient-text">Pet Care Tips</span>
            </h2>
            <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
                Subscribe to our newsletter and get the latest pet care advice, adoption stories, and expert tips delivered to your inbox.
            </p>
            <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
                <input type="email" placeholder="Enter your email" class="flex-1 glass px-4 py-3 rounded-full bg-transparent text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-blue border-0">
                <button type="submit" class="bg-gradient-to-r from-primary-blue to-primary-purple px-6 py-3 rounded-full text-white font-semibold hover:from-primary-purple hover:to-primary-blue transition-all duration-300">
                    Subscribe
                </button>
            </form>
            <p class="text-gray-400 text-sm mt-4">
                No spam, unsubscribe at any time. We respect your privacy.
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Category filtering
            const categoryFilters = document.querySelectorAll('.category-filter');
            const blogPosts = document.querySelectorAll('.blog-post');
            
            categoryFilters.forEach(filter => {
                filter.addEventListener('click', function() {
                    const category = this.getAttribute('data-category');
                    
                    // Update active state
                    categoryFilters.forEach(f => {
                        f.classList.remove('active', 'bg-primary-blue', 'text-white');
                        f.classList.add('text-gray-300');
                    });
                    this.classList.add('active', 'bg-primary-blue', 'text-white');
                    this.classList.remove('text-gray-300');
                    
                    // Filter posts
                    blogPosts.forEach(post => {
                        if (category === 'all' || post.getAttribute('data-category') === category) {
                            post.style.display = 'block';
                            post.style.animation = 'fadeIn 0.5s ease-in-out';
                        } else {
                            post.style.display = 'none';
                        }
                    });
                });
            });
            
            // Search functionality
            const searchInput = document.getElementById('search-input');
            const searchBtn = document.getElementById('search-btn');
            
            function searchPosts() {
                const searchTerm = searchInput.value.toLowerCase();
                
                blogPosts.forEach(post => {
                    const title = post.querySelector('h3').textContent.toLowerCase();
                    const content = post.querySelector('p').textContent.toLowerCase();
                    
                    if (title.includes(searchTerm) || content.includes(searchTerm)) {
                        post.style.display = 'block';
                    } else {
                        post.style.display = 'none';
                    }
                });
            }
            
            searchBtn.addEventListener('click', searchPosts);
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    searchPosts();
                }
            });
            
            // Load more functionality (simulated)
            const loadMoreBtn = document.getElementById('load-more');
            loadMoreBtn.addEventListener('click', function() {
                this.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Loading...';
                
                setTimeout(() => {
                    this.innerHTML = 'Load More Articles <i class="fas fa-chevron-down ml-2"></i>';
                    // In a real application, you would fetch more posts here
                }, 1000);
            });
        });
        
        // Add fadeIn animation
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes fadeIn {
                from { opacity: 0; transform: translateY(10px); }
                to { opacity: 1; transform: translateY(0); }
            }
        `;
        document.head.appendChild(style);
    </script>
}

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .glass {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .glass-dark {
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .gradient-text {
        background: linear-gradient(135deg, #2979FF, #00E676, #FF80AB);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradient 3s ease infinite;
    }
    
    .sharp-shadow {
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    }
    
    .category-filter.active {
        background: #2979FF !important;
        color: white !important;
    }
    
    input:focus {
        outline: none;
    }
</style> 